<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Aucun trafic en clair : tous les flux radio sont en HTTPS. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
